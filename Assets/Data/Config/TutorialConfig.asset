  m_Script: {fileID: 11500000, guid: 2c24e1a5298b66a4eb7d17b49fb5fb1f, type: 3}
  m_Name: TutorialConfig
  m_EditorClassIdentifier: BallSort.Game::BallSort.Game.Services.TutorialConfig
  _entries:
  - _levelId: 1
    _text: Tap a tube, then tap the target. Put same-color monsters together!
    _image: {fileID: 0}
  - _levelId: 7
    _text: "Move the top monster to <color=#FFD23A>REVEAL</color> the one\_below!\n<size=75%>A
      \"?\" shows its color once it is on top.</size>"
    _image: {fileID: 0}
  - _levelId: 20
    _text: "Gather one color in the\_<color=#FFD23A>BIG\_TUBE</color>!\n<size=75%>It
      only takes its own color.</size>"
    _image: {fileID: 0}
  - _levelId: 30
    _text: "Complete the badge color to lift the\_<color=#FFD23A>TOWEL</color>!\n<size=75%>The
      tube under it opens up.</size>"
    _image: {fileID: 0}
  - _levelId: 55
    _text: "Fill the tube to break the\_<color=#FFD23A>ICE</color>!\n<size=75%>You
      can pour in, but never out.</size>"
    _image: {fileID: 0}
  - _levelId: 80
    _text: "Find the <color=#FFD23A>KEY</color> to open the\_<color=#FFD23A>BOX</color>!\n<size=75%>Dig
      out the monster carrying it.</size>"
    _image: {fileID: 0}
